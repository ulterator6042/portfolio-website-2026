---
/**
 * Photography — the merged infinite-scroll gallery (ported from the standalone
 * picture-website). It runs full-screen with its own canvas engine, so it does
 * NOT use the portfolio's Base layout/nav; instead it keeps its immersive UI
 * and adds a single link back to the portfolio. Images + variants are built by
 * Astro's sharp pipeline at build time, same as the original.
 */
import { getImage } from 'astro:assets';
import META from '../../gallery/data/meta.js';

import '../../gallery/styles/reset.css';
import '../../gallery/styles/gallery.css';
import '../../gallery/styles/detail.css';

const imageModules = import.meta.glob(
  '../../gallery/images/*.{jpg,JPG,jpeg,JPEG,png,PNG,webp,WEBP}',
  { eager: true }
);

async function variants(src) {
  const [thumb, full, download] = await Promise.all([
    getImage({ src, width: 600,  format: 'webp', quality: 72 }),
    getImage({ src, width: 2000, format: 'webp', quality: 82 }),
    getImage({ src, width: Math.min(src.width, 2600), format: 'webp', quality: 86 }),
  ]);
  return { thumb: thumb.src, full: full.src, download: download.src };
}

const photos = [];
let id = 1;
for (const [path, mod] of Object.entries(imageModules)) {
  const img = mod.default;
  const filename = path.split('/').pop();
  const v = await variants(img);
  const meta = META[filename] || {};
  photos.push({
    id: id++,
    thumb: v.thumb,
    full: v.full,
    download: v.download,
    aspect: +(img.width / img.height).toFixed(4),
    title: meta.title ?? filename.replace(/\.[^.]+$/, ''),
    date: meta.date ?? '',
    location: meta.location ?? '',
    description: meta.description ?? '',
  });
}
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Photography — Matteo Isabella</title>
  <link rel="icon" href="/favicon.svg" />
  <!-- Cloudflare Web Analytics -->
  <script
    type="module"
    src="https://static.cloudflareinsights.com/beacon.min.js"
    data-cf-beacon='{"token": "3b52754f7a114ef193fcb27ec79c7178"}'
  ></script>
  <!-- End Cloudflare Web Analytics -->
  <!-- Microsoft Clarity -->
  <!-- Standalone page (no ClientRouter), so a plain guarded loader is enough.
       See Base.astro for the persisted-holder variant used by the SPA pages. -->
  <script is:inline type="text/javascript">
    if (!window.clarity) {
      (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "ys63ilzx54");
    }
  </script>
  <!-- End Microsoft Clarity -->
</head>
<body>
  <a class="gallery-back" href="/#work">← Portfolio</a>

  <div id="gallery-canvas"></div>

  <div class="edge-indicator edge-top"></div>
  <div class="edge-indicator edge-bottom"></div>
  <div class="edge-indicator edge-left"></div>
  <div class="edge-indicator edge-right"></div>

  <div id="detail-overlay">
    <div class="detail-content">
      <div class="detail-info">
        <h2 id="detail-title"></h2>
        <div class="detail-meta">
          <span id="detail-date"></span>
          <span id="detail-location"></span>
        </div>
        <p id="detail-desc"></p>
      </div>
      <div id="detail-preview"></div>
    </div>
    <button id="detail-download" aria-label="Download">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
        <polyline points="7 10 12 15 17 10"/>
        <line x1="12" y1="15" x2="12" y2="3"/>
      </svg>
    </button>
    <button id="detail-close" aria-label="Close">&times;</button>
  </div>

  <script is:inline define:vars={{ photos }}>
    window.__PHOTOS__ = photos;
  </script>

  <script>
    import { init } from '../../gallery/scripts/gallery.js';
    import '../../gallery/scripts/detail.js';
    init(window.__PHOTOS__ || []);
  </script>

  <style is:global>
    .gallery-back {
      position: fixed;
      top: 1rem;
      left: 1rem;
      z-index: 100;
      font-family: 'DM Sans', system-ui, sans-serif;
      font-weight: 500;
      font-size: 0.85rem;
      line-height: 1;
      color: #fff;
      text-decoration: none;
      padding: 0.55rem 0.95rem;
      border-radius: 999px;
      background: rgba(0, 0, 0, 0.45);
      border: 1px solid rgba(255, 255, 255, 0.14);
      backdrop-filter: blur(8px);
      transition:
        background 0.2s cubic-bezier(0.22, 1, 0.36, 1),
        transform 0.2s cubic-bezier(0.22, 1, 0.36, 1),
        border-color 0.2s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .gallery-back:hover {
      background: rgba(0, 0, 0, 0.72);
      border-color: rgba(255, 255, 255, 0.3);
      transform: translateX(-2px);
    }
    .gallery-back:focus-visible {
      outline: 2px solid #fff;
      outline-offset: 3px;
    }
  </style>
</body>
</html>
