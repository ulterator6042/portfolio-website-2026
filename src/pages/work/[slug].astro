---
import { render } from 'astro:content';
import Base from '@layouts/Base.astro';
import ProjectHeader from '@components/ProjectHeader.astro';
import ProjectRail from '@components/ProjectRail.astro';
import { getProjects } from '../../lib/projects';

export async function getStaticPaths() {
  const projects = await getProjects();
  // Skip projects that render through a custom route (e.g. photography).
  return projects
    .filter((p) => !p.data.externalTemplate)
    .map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;
// Side rail mirrors the Figma project column — the built case studies only
// (exclude custom-route entries like the Photography gallery).
const railProjects = (await getProjects()).filter((p) => !p.data.externalTemplate);
const dark = d.dark;
// Per-project accent → --accent on the shell (falls back to the global token).
const accentVars = [
  d.accent && `--accent:${d.accent}`,
  d.accentText && `--accent-text:${d.accentText}`,
]
  .filter(Boolean)
  .join(';');
---
<Base title={d.title} description={d.summary}>
  <div class:list={['case-shell', { dark }]} style={accentVars}>
    <ProjectRail projects={railProjects} current={project.id} dark={dark} />
    <article class="case">
      {!d.hideHeader && (
        <ProjectHeader
          title={d.title}
          summary={d.summary}
          category={d.category}
          year={d.year}
          role={d.role}
          tools={d.tools}
          cover={d.cover}
        />
      )}
      <div class:list={['case__body', { 'case__body--flush': d.hideHeader }]}>
        <Content />
      </div>
    </article>
  </div>
</Base>

<!-- Case-study pages use the custom CaseScrollIndicator, so hide the native
     scrollbar here (scroll still works). Scoped to these pages only — About /
     Photography keep their normal scrollbar. -->
<style is:global>
  html { scrollbar-width: none; }        /* Firefox */
  html::-webkit-scrollbar { display: none; } /* Chromium / WebKit */
</style>

<style>
  .case-shell {
    display: flex;
    align-items: flex-start;
  }
  .case {
    flex: 1 1 auto;
    min-width: 0;
  }
  /* Dark case studies (Grab) paint the whole shell dark. */
  .case-shell.dark { background: #0e0e0e; color: #fff; }

  .case__body { margin-top: clamp(2rem, 6vw, 4rem); }
  /* Full-bleed case studies render their own hero flush under the nav. */
  .case__body--flush { margin-top: 0; }
</style>
