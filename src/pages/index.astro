---
import Base from '@layouts/Base.astro';
import { site, categories } from '@config/site';
import { getProjects, projectHref } from '../lib/projects';

const all = await getProjects();
// Photography is not a column item — it's a header link next to About.
const projects = all.filter((p) => p.data.category !== 'photography');
const catLabel = (id: string) => categories.find((c) => c.id === id)?.label ?? id;

// A few keywords surfaced in each item's drop-down. Prefer the project's
// tools; fall back to the year so the panel is never empty.
const keywordsFor = (p: (typeof projects)[number]) => {
  const tools = p.data.tools ?? [];
  const picks = tools.slice(0, 3);
  if (picks.length === 0 && p.data.year) picks.push(String(p.data.year));
  return picks;
};
---
<Base bare={true} lockScroll={true}>
  <div class="home">
    <!-- Dark top bar: name + section links -->
    <header class="topbar">
      <span class="topbar__name">{site.name}</span>
      <nav class="topbar__links">
        <a href="/about">About me</a>
        <a href="/work/photography">Photography</a>
      </nav>
    </header>

    <div class="stage">
      <!-- Left: the project menu — identical behaviour to the in-project rail.
           Each item links straight to that project's scrollable page. -->
      <div class="col">
        <nav class="list" aria-label="Projects" data-list>
          <!-- The gradient spotlight that chases the hovered item (decorative). -->
          <span class="glow" data-glow aria-hidden="true"></span>
          {projects.map((p) => (
            <a class="list__item" href={projectHref(p)} data-item>
              <span class="list__head">
                <span class="list__name">{p.data.title}</span>
                {p.data.wip && <span class="list__soon">Soon</span>}
              </span>
              <span class="list__panel">
                <span class="list__panel-inner">
                  <span class="list__cat">{catLabel(p.data.category)}</span>
                  {keywordsFor(p).map((k) => (
                    <span class="list__kw">{k}</span>
                  ))}
                </span>
              </span>
            </a>
          ))}
        </nav>
        <div class="scroll-cue" data-cue hidden aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </div>
      </div>

      <!-- Right: home intro -->
      <section class="detail">
        <div class="intro">
          <p class="eyebrow">{site.tagline}</p>
          <h1 class="intro__title">{site.intro}</h1>
          <p class="intro__hint">Select a project to open it.</p>
        </div>
      </section>
    </div>
  </div>
</Base>

<script>
  // Scroll cue: show the chevron only when the list has more below the fold.
  const list = document.querySelector<HTMLElement>('.list');
  const cue = document.querySelector<HTMLElement>('[data-cue]');
  function updateCue() {
    if (!list || !cue) return;
    const more = list.scrollHeight - list.clientHeight - list.scrollTop > 4;
    cue.hidden = !more;
  }
  list?.addEventListener('scroll', updateCue, { passive: true });
  window.addEventListener('resize', updateCue);
  updateCue();

  // ── Gradient spotlight ────────────────────────────────────────────────
  // A soft glow eases toward whichever item is hovered/focused, re-reading
  // the target every frame so it grows in sync with the drop-down opening.
  const glow = document.querySelector<HTMLElement>('[data-glow]');
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-item]'));
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (glow && list && items.length && !reduce) {
    let active: HTMLElement | null = null;   // item the pointer is on
    let raf = 0;
    // Current (rendered) box and its eased velocity.
    let cy = 0, ch = 0, opacity = 0;
    let settled = true;

    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

    function frame() {
      if (!glow || !list) return;
      // Target: live geometry of the active item (relative to the scroll area).
      const ty = active ? active.offsetTop - list.scrollTop : cy;
      const th = active ? active.offsetHeight : ch;
      const to = active ? 1 : 0;

      cy = lerp(cy, ty, 0.22);
      ch = lerp(ch, th, 0.22);
      opacity = lerp(opacity, to, 0.18);

      glow.style.transform = `translateY(${cy}px)`;
      glow.style.height = `${ch}px`;
      glow.style.opacity = `${opacity}`;

      const done =
        !active &&
        Math.abs(opacity) < 0.01 &&
        Math.abs(cy - ty) < 0.5 &&
        Math.abs(ch - th) < 0.5;
      if (done) {
        settled = true;
        glow.style.opacity = '0';
        raf = 0;
        return;
      }
      raf = requestAnimationFrame(frame);
    }

    function kick() {
      settled = false;
      if (!raf) raf = requestAnimationFrame(frame);
    }

    items.forEach((el) => {
      const enter = () => {
        // First appearance: snap the glow onto the item so it fades in place
        // instead of sliding in from the top.
        if (settled && opacity < 0.02 && list) {
          cy = el.offsetTop - list.scrollTop;
          ch = el.offsetHeight;
        }
        active = el;
        kick();
      };
      el.addEventListener('pointerenter', enter);
      el.addEventListener('focus', enter);
    });

    const clear = () => { active = null; kick(); };
    list.addEventListener('pointerleave', clear);
    list.addEventListener('focusout', (e) => {
      if (!list.contains(e.relatedTarget as Node)) clear();
    });
    // Keep the glow pinned to the active item while the list scrolls.
    list.addEventListener('scroll', () => { if (active) kick(); }, { passive: true });
  }
</script>

<style>
  .home { height: 100dvh; display: flex; flex-direction: column; }

  /* Top bar */
  .topbar {
    flex: 0 0 auto;
    height: 72px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: 30px;
    background: var(--header-bg);
  }
  .topbar__name {
    color: var(--header-text);
    font-weight: 700;
    font-size: 2rem;
    letter-spacing: -0.02em;
  }
  .topbar__links { display: flex; gap: 1.75rem; }
  .topbar__links a {
    color: var(--header-text);
    text-decoration: underline 1.5px transparent;
    text-underline-offset: 4px;
    font-size: 0.95rem;
    transition: text-decoration-color 0.15s ease, color 0.15s ease;
  }
  .topbar__links a:hover {
    color: #fff;
    text-decoration-color: #fff; /* white underline on hover */
  }

  /* Stage = list + detail */
  .stage {
    flex: 1 1 auto;
    min-height: 0;
    display: grid;
    grid-template-columns: clamp(360px, 42%, 520px) 1fr;
  }

  /* Left column wrapper (holds the scroll area + the scroll cue) */
  .col {
    position: relative;
    min-height: 0;
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--border);
  }
  .list {
    position: relative; /* anchor for the gradient spotlight */
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    /* Left padding = 30px so the column aligns with the header name. */
    padding: 2rem 20px 2rem 30px;
    overflow-y: auto;
    scrollbar-width: none; /* Firefox */
  }
  .list::-webkit-scrollbar { display: none; } /* Chromium/WebKit */

  /* ── Gradient spotlight — eases behind the hovered item (see <script>) ── */
  .glow {
    position: absolute;
    left: 8px;
    right: 8px;
    top: 2rem; /* matches list padding; JS drives translateY from here */
    height: 0;
    opacity: 0;
    border-radius: 14px;
    pointer-events: none;
    z-index: 0;
    background:
      radial-gradient(120% 80% at 8% 50%,
        color-mix(in srgb, var(--accent) 20%, transparent) 0%,
        color-mix(in srgb, var(--accent) 9%, transparent) 45%,
        transparent 78%);
    will-change: transform, height, opacity;
  }

  /* ── Menu item — big text + reveal-on-hover drop-down ─────────────────── */
  .list__item {
    position: relative;
    z-index: 1;
    display: block;
    padding: 10px 14px;
    text-decoration: none;
    color: inherit;
    border-radius: 14px;
  }
  .list__head { display: flex; align-items: baseline; gap: 12px; }
  .list__name {
    position: relative;
    font-family: 'DM Sans', sans-serif;
    font-weight: 600;
    font-size: clamp(1.5rem, 2.6vw, 2.15rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: #6b6b6b;
    transition: color 0.25s ease;
  }
  /* Animated underline — grows left→right on hover/focus. */
  .list__name::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .list__item:hover .list__name,
  .list__item:focus-visible .list__name { color: #111111; }
  .list__item:hover .list__name::after,
  .list__item:focus-visible .list__name::after { transform: scaleX(1); }

  /* "Soon" chip (e.g. Talaris) */
  .list__soon {
    align-self: center;
    padding: 3px 9px;
    border-radius: 999px;
    background: rgba(10, 10, 10, 0.08);
    color: var(--muted);
    font-family: 'DM Sans', sans-serif;
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Drop-down — animates open via the 0fr → 1fr grid-rows technique. */
  .list__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .list__panel-inner {
    overflow: hidden;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    /* Padding-top lives here so it collapses to zero with the row. */
    padding-top: 0;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 0.3s ease 0.05s, transform 0.3s ease 0.05s,
      padding-top 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .list__item:hover .list__panel,
  .list__item:focus-visible .list__panel { grid-template-rows: 1fr; }
  .list__item:hover .list__panel-inner,
  .list__item:focus-visible .list__panel-inner {
    opacity: 1;
    transform: translateY(0);
    padding-top: 10px;
  }

  .list__cat {
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-text, #fff);
    font-family: 'DM Sans', sans-serif;
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .list__kw {
    padding: 4px 11px;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--muted);
    font-family: 'DM Sans', sans-serif;
    font-size: 12px;
    white-space: nowrap;
  }

  /* Scroll cue — fades in over the bottom of the list when scrollable */
  .scroll-cue {
    position: absolute;
    left: 0;
    right: 1px;
    bottom: 0;
    height: 48px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 6px;
    color: var(--muted);
    background: linear-gradient(to top, var(--bg) 35%, transparent);
    pointer-events: none;
    animation: cue-bounce 1.6s ease-in-out infinite;
  }
  .scroll-cue[hidden] { display: none; }
  @keyframes cue-bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(3px); }
  }

  /* Right side — home intro */
  .detail { position: relative; min-height: 0; }
  .intro {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2rem, 6vw, 5rem);
  }
  .intro__title { max-width: 20ch; margin-top: 1rem; font-size: clamp(2rem, 4.5vw, 3.5rem); }
  .intro__hint { margin-top: 1.5rem; color: var(--muted); font-size: 0.9rem; }

  @media (max-width: 720px) {
    .stage { grid-template-columns: 1fr; }
    .detail { display: none; }
  }
</style>
