---
import Base from '@layouts/Base.astro';
import ProjectMenu from '@components/ProjectMenu.astro';
import { site } from '@config/site';
import { getProjects } from '../lib/projects';

const all = await getProjects();
// Photography is not a column item — it's a header link next to About.
const projects = all.filter((p) => p.data.category !== 'photography');
---
<Base bare={true} lockScroll={true}>
  <div class="home">
    <!-- Dark top bar: name + section links -->
    <header class="topbar">
      <a class="topbar__name" href="/">{site.name}</a>
      <nav class="topbar__links">
        <a class="u-underline" href="/about">About me</a>
        <a class="u-underline" href="/work/photography">Photography</a>
      </nav>
    </header>

    <div class="stage">
      <!-- Left: the shared project menu (same component powers the case rail). -->
      <div class="col">
        <ProjectMenu projects={projects} variant="hero" />
        <div class="scroll-cue" data-cue hidden aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
        </div>
      </div>

      <!-- Right: home intro -->
      <section class="detail">
        <div class="intro">
          <p class="eyebrow">{site.tagline}</p>
          <h1 class="intro__title">{site.intro}</h1>
          <p class="intro__hint">Select a project to open it.</p>
        </div>
      </section>
    </div>
  </div>
</Base>

<script>
  // Scroll cue: show the chevron only when the menu has more below the fold.
  // (The spotlight interaction lives inside the ProjectMenu component.)
  const menu = document.querySelector<HTMLElement>('.pmenu');
  const cue = document.querySelector<HTMLElement>('[data-cue]');
  function updateCue() {
    if (!menu || !cue) return;
    const more = menu.scrollHeight - menu.clientHeight - menu.scrollTop > 4;
    cue.hidden = !more;
  }
  menu?.addEventListener('scroll', updateCue, { passive: true });
  window.addEventListener('resize', updateCue);
  updateCue();
</script>

<style>
  .home { height: 100dvh; display: flex; flex-direction: column; }

  /* Top bar */
  .topbar {
    flex: 0 0 auto;
    min-height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 30px;
    background: var(--header-bg);
  }
  .topbar__name {
    color: #fff;
    font-weight: 700;
    font-size: 1.6rem;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .topbar__links { display: flex; gap: 1.75rem; }
  .topbar__links a {
    color: var(--header-text);
    font-size: 0.95rem;
    transition: color var(--dur-1) var(--ease-out);
  }
  .topbar__links a:hover,
  .topbar__links a:focus-visible { color: #fff; }

  /* Stage = list + detail */
  .stage {
    flex: 1 1 auto;
    min-height: 0;
    display: grid;
    grid-template-columns: clamp(360px, 42%, 520px) 1fr;
  }

  /* Left column wrapper (holds the shared ProjectMenu + the scroll cue). The
     menu component owns its own list styling; this just frames the column. */
  .col {
    position: relative;
    min-height: 0;
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--border);
  }

  /* Scroll cue — fades in over the bottom of the list when scrollable */
  .scroll-cue {
    position: absolute;
    left: 0;
    right: 1px;
    bottom: 0;
    height: 48px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 6px;
    color: var(--muted);
    background: linear-gradient(to top, var(--bg) 35%, transparent);
    pointer-events: none;
    animation: cue-bounce 1.6s ease-in-out infinite;
  }
  .scroll-cue[hidden] { display: none; }
  @keyframes cue-bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(3px); }
  }

  /* Right side — home intro */
  .detail { position: relative; min-height: 0; }
  .intro {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2rem, 6vw, 5rem);
  }
  .intro__title { max-width: 20ch; margin-top: 1rem; font-size: clamp(2rem, 4.5vw, 3.5rem); }
  .intro__hint { margin-top: 1.5rem; color: var(--muted); font-size: 0.9rem; }

  @media (max-width: 720px) {
    .stage { grid-template-columns: 1fr; }
    .detail { display: none; }
  }
</style>
