---
/**
 * The one project menu, shared by the home hero and every case-study rail so
 * the site's primary navigation is identical everywhere. Plain text items; on
 * hover/focus the title brightens to a neutral text colour, and the current
 * project keeps the accent colour with an underline that morphs across pages
 * on navigation. Minimal — no spotlight/glow behind the items.
 */
import { projectHref, type Project } from '../lib/projects';

interface Props {
  projects: Project[];
  current?: string;
  /** Colour of the small hover dot (theme accent on project pages, text
      colour on the home/about menu). */
  dotColor?: string;
}
const { projects, current, dotColor = 'var(--text)' } = Astro.props;

// The menu is split into disciplines, each with a heading + divider. Industrial
// design first, then UI/UX. Projects keep the order defined by their `order`
// field; only the grouping is applied here.
const groups = [
  { id: 'product', label: 'Industrial Design' },
  { id: 'uiux', label: 'UI/UX' },
] as const;
const sections = groups
  .map((g) => ({ ...g, items: projects.filter((p) => p.data.category === g.id) }))
  .filter((g) => g.items.length > 0);
// Anything that doesn't fall into a named group still shows (ungrouped, no
// heading) so a new category never silently disappears from the menu.
const known = new Set(groups.map((g) => g.id));
const ungrouped = projects.filter((p) => !known.has(p.data.category as typeof groups[number]['id']));
---
<nav class="pmenu" aria-label="Projects" style={`--dot-color:${dotColor}`}>
  {sections.map((section) => (
    <div class="pmenu__group">
      <p class="pmenu__heading">{section.label}</p>
      {section.items.map((p) => (
        <a
          class:list={['pmenu__item', { active: p.id === current }]}
          href={projectHref(p)}
          aria-current={p.id === current ? 'page' : undefined}
        >
          <span class="pmenu__dot" aria-hidden="true"></span>
          <span class="pmenu__name">
            {p.data.title}
            {/* Real underline element on the current project. It carries a shared
                view-transition-name so the browser morphs it (width + colour) from
                the old project to the new one when you navigate. */}
            {p.id === current && (
              <span class="pmenu__rule" transition:name="proj-underline"></span>
            )}
          </span>
          {p.data.wip && <span class="pmenu__tag">Soon</span>}
        </a>
      ))}
    </div>
  ))}
  {ungrouped.map((p) => (
    <a
      class:list={['pmenu__item', { active: p.id === current }]}
      href={projectHref(p)}
      aria-current={p.id === current ? 'page' : undefined}
    >
      <span class="pmenu__dot" aria-hidden="true"></span>
      <span class="pmenu__name">
        {p.data.title}
        {p.id === current && (
          <span class="pmenu__rule" transition:name="proj-underline"></span>
        )}
      </span>
      {p.data.wip && <span class="pmenu__tag">Soon</span>}
    </a>
  ))}
</nav>

<style>
  .pmenu {
    position: relative; /* containing block for the spotlight */
    flex: 1 1 auto;     /* fills the middle of the sidebar */
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    overflow-y: auto;
    scrollbar-width: none; /* Firefox */
    --pmenu-fs: 1.12rem;
    --pmenu-pad: 7px 12px;
    padding: 4px 18px 8px 18px; /* item text lands at 30px, aligned with name */
  }
  .pmenu::-webkit-scrollbar { display: none; } /* Chromium/WebKit */

  /* ── Discipline group ───────────────────────────────────────────────────
     Each section is a small uppercase heading over a hairline divider, then
     its projects. The first group drops its top gap so it sits snug under the
     name. */
  .pmenu__group { display: flex; flex-direction: column; gap: 2px; }
  .pmenu__group + .pmenu__group { margin-top: 18px; }
  .pmenu__heading {
    margin: 0 0 6px;
    padding: 0 12px 6px;
    border-bottom: 1px solid var(--border);
    color: var(--text);
    font-weight: 700;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* ── Item ───────────────────────────────────────────────────────────── */
  .pmenu__item {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: var(--pmenu-pad);
    text-decoration: none;
    color: inherit;
    border-radius: 12px;
  }
  /* Small hover dot to the left of the item. Colour is driven by --dot-color
     (accent on project pages, text colour on the home/about menu). */
  .pmenu__dot {
    position: absolute;
    left: 2px;
    top: 50%;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--dot-color, var(--text));
    opacity: 0;
    transform: translate(-4px, -50%) scale(0.5);
    transition:
      opacity var(--dur-1, 0.12s) var(--ease-out, ease),
      transform var(--dur-1, 0.12s) var(--ease-out, ease);
    pointer-events: none;
  }
  .pmenu__item:hover .pmenu__dot,
  .pmenu__item:focus-visible .pmenu__dot {
    opacity: 1;
    transform: translate(0, -50%) scale(1);
  }

  .pmenu__name {
    position: relative;
    font-weight: 500;
    font-size: var(--pmenu-fs);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--muted);
    transition: color var(--dur-2, 0.32s) var(--ease-in-out, ease);
  }
  /* Current project's underline — a real element that morphs across pages.
     Only the current item gets a line. Hovering shows just the gradient
     spotlight, so nothing competes with this line as it travels from one
     project to the next on navigation. */
  .pmenu__rule {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background: var(--accent);
    border-radius: 2px;
  }
  /* Hover / focus brighten to a neutral text colour (minimal, no accent).
     Only the current project keeps the accent colour + underline. */
  .pmenu__item:hover .pmenu__name,
  .pmenu__item:focus-visible .pmenu__name { color: var(--text); }
  .pmenu__item.active .pmenu__name { color: var(--accent); font-weight: 600; }

  /* Drive the underline morph: interpolate position + width over the same beat
     as the page slide; the old/new colours cross-fade as it travels. */
  :global(::view-transition-group(proj-underline)) {
    animation-duration: 300ms;
    animation-timing-function: var(--ease-in-out, ease);
  }

  /* Discipline / status chip (UI/UX · Product · Soon). Hidden in the resting
     menu; fades in only when the item is hovered or focused. */
  .pmenu__tag {
    align-self: center;
    padding: 3px 9px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--text) 9%, transparent);
    color: var(--muted);
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity var(--dur-1, 0.12s) var(--ease-out, ease),
      transform var(--dur-1, 0.12s) var(--ease-out, ease);
    pointer-events: none;
  }
  .pmenu__item:hover .pmenu__tag,
  .pmenu__item:focus-visible .pmenu__tag {
    opacity: 1;
    transform: none;
  }

  /* On mobile the menu lives in a tap-driven drawer with no hover, so the
     discipline chips are shown at rest instead of fading in on hover. */
  @media (max-width: 720px) {
    .pmenu__tag {
      opacity: 1;
      transform: none;
    }
  }
</style>

