---
/**
 * The one project menu, shared by the home hero and every case-study rail so
 * the site's primary navigation is identical everywhere. Plain text items; on
 * hover/focus (or when it's the current project) the title takes the accent
 * colour and an underline grows in, while a soft gradient spotlight eases
 * behind it. `variant` only changes how the column is placed (the home menu
 * fills its column; the rail sticks) — the items look and behave the same.
 * The glow picks up whatever `--accent` is in scope, so on a case page it takes
 * that project's colour.
 */
import { projectHref, type Project } from '../lib/projects';

interface Props {
  projects: Project[];
  current?: string;
  variant?: 'hero' | 'rail';
}
const { projects, current, variant = 'hero' } = Astro.props;
---
<nav class:list={['pmenu', `pmenu--${variant}`]} aria-label="Projects" data-pmenu>
  <!-- Gradient spotlight that chases the active item (decorative; see script). -->
  <span class="pmenu__glow" data-glow aria-hidden="true"></span>
  {projects.map((p, i) => (
    <a
      class:list={['pmenu__item', { active: p.id === current }]}
      href={projectHref(p)}
      data-item
      aria-current={p.id === current ? 'page' : undefined}
      style={`--i:${i}`}
    >
      <span class="pmenu__name">
        {p.data.title}
        {/* Real underline element on the current project. It carries a shared
            view-transition-name so the browser morphs it (width + colour) from
            the old project to the new one when you navigate. */}
        {p.id === current && (
          <span class="pmenu__rule" transition:name="proj-underline"></span>
        )}
      </span>
      {p.data.wip && <span class="pmenu__soon">Soon</span>}
    </a>
  ))}
</nav>

<style>
  .pmenu {
    position: relative; /* containing block for the spotlight */
    display: flex;
    flex-direction: column;
    gap: 2px;
    overflow-y: auto;
    scrollbar-width: none; /* Firefox */
    /* Shared item metrics — identical in both contexts. */
    --pmenu-fs: 1.12rem;
    --pmenu-pad: 7px 12px;
    padding: 26px 18px 26px 30px;
  }
  .pmenu::-webkit-scrollbar { display: none; } /* Chromium/WebKit */

  /* ── Variant = column placement only (items are the same) ────────────── */
  .pmenu--hero {
    flex: 1 1 auto;
    min-height: 0;
  }
  .pmenu--rail {
    position: sticky;
    top: var(--nav-h); /* clears the sticky top nav */
    max-height: calc(100vh - var(--nav-h));
  }

  /* ── Gradient spotlight ─────────────────────────────────────────────── */
  .pmenu__glow {
    position: absolute;
    left: 8px;
    right: 8px;
    top: 0; /* JS drives translateY relative to the scroll area */
    height: 0;
    opacity: 0;
    border-radius: 12px;
    pointer-events: none;
    z-index: 0;
    background:
      radial-gradient(120% 80% at 6% 50%,
        color-mix(in srgb, var(--accent) 22%, transparent) 0%,
        color-mix(in srgb, var(--accent) 9%, transparent) 46%,
        transparent 78%);
    will-change: transform, height, opacity;
  }

  /* ── Item ───────────────────────────────────────────────────────────── */
  .pmenu__item {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: var(--pmenu-pad);
    text-decoration: none;
    color: inherit;
    border-radius: 12px;
  }
  /* Signature: staggered rise on first paint (home only). */
  .pmenu--hero .pmenu__item {
    opacity: 0;
    animation: pmenu-rise 0.42s var(--ease-out, ease) both;
    animation-delay: calc(80ms + var(--i) * 45ms);
  }
  @keyframes pmenu-rise {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .pmenu__name {
    position: relative;
    font-weight: 600;
    font-size: var(--pmenu-fs);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--muted);
    transition: color var(--dur-2, 0.32s) var(--ease-in-out, ease);
  }
  /* Current project's underline — a real element that morphs across pages.
     Only the current item gets a line. Hovering shows just the gradient
     spotlight, so nothing competes with this line as it travels from one
     project to the next on navigation. */
  .pmenu__rule {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background: var(--accent);
    border-radius: 2px;
  }
  /* Hover, focus, and current-project all take the accent colour. */
  .pmenu__item:hover .pmenu__name,
  .pmenu__item:focus-visible .pmenu__name,
  .pmenu__item.active .pmenu__name { color: var(--accent); }

  /* Drive the underline morph: interpolate position + width over the same beat
     as the page slide; the old/new colours cross-fade as it travels. */
  :global(::view-transition-group(proj-underline)) {
    animation-duration: 300ms;
    animation-timing-function: var(--ease-in-out, ease);
  }

  /* "Soon" chip (e.g. Talaris) */
  .pmenu__soon {
    align-self: center;
    padding: 3px 9px;
    border-radius: 999px;
    background: color-mix(in srgb, currentColor 10%, transparent);
    color: var(--muted);
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
</style>

<script>
  // Gradient spotlight: a soft glow eases toward whichever item is hovered or
  // focused. On the rail it rests on the current project until you hover.
  // Runs on every page load AND after each client-side navigation.
  function initPmenu() {
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-pmenu]').forEach((nav) => {
    const glow = nav.querySelector<HTMLElement>('[data-glow]');
    const items = Array.from(nav.querySelectorAll<HTMLElement>('[data-item]'));
    if (!glow || !items.length) return;
    const rest = nav.querySelector<HTMLElement>('[data-item].active');

    const place = (el: HTMLElement) => {
      glow!.style.transform = `translateY(${el.offsetTop - nav.scrollTop}px)`;
      glow!.style.height = `${el.offsetHeight}px`;
    };

    if (reduce) {
      // No motion: pin a static highlight on the active item, if any.
      if (rest) { place(rest); glow.style.opacity = '0.5'; }
      return;
    }

    let hovered: HTMLElement | null = null;
    let raf = 0;
    // Rendered state + the eased tween each move runs through.
    let cy = 0, ch = 0, op = 0;
    let fy = 0, fh = 0, fo = 0;   // from
    let ty = 0, th = 0, to = 0;   // to
    let t0 = 0;
    const DUR = 240;              // ms per move — snappy follow
    // easeOutCubic — quick to respond, gentle to settle.
    const easeInOut = (t: number) => 1 - Math.pow(1 - t, 3);

    const targetEl = () => hovered ?? rest ?? null;
    const targetOp = () => (hovered ? 1 : rest ? 0.5 : 0);

    function retarget() {
      const el = targetEl();
      // Fresh appearance: place the box on the item so it fades in, not slides.
      if (!hovered && op < 0.02 && el) { cy = el.offsetTop - nav.scrollTop; ch = el.offsetHeight; }
      fy = cy; fh = ch; fo = op;
      ty = el ? el.offsetTop - nav.scrollTop : cy;
      th = el ? el.offsetHeight : ch;
      to = targetOp();
      t0 = performance.now();
      if (!raf) raf = requestAnimationFrame(frame);
    }

    function frame(now: number) {
      const t = Math.min(1, (now - t0) / DUR);
      const e = easeInOut(t);
      cy = fy + (ty - fy) * e;
      ch = fh + (th - fh) * e;
      op = fo + (to - fo) * e;
      glow!.style.transform = `translateY(${cy}px)`;
      glow!.style.height = `${ch}px`;
      glow!.style.opacity = `${op}`;
      if (t < 1) raf = requestAnimationFrame(frame); else raf = 0;
    }

    // Rest on the current item (or the first) and fade in place.
    const startEl = rest ?? items[0];
    cy = startEl.offsetTop - nav.scrollTop;
    ch = startEl.offsetHeight;
    retarget();

    items.forEach((el) => {
      const enter = () => {
        if (!hovered && op < 0.02) { cy = el.offsetTop - nav.scrollTop; ch = el.offsetHeight; }
        hovered = el;
        retarget();
      };
      el.addEventListener('pointerenter', enter);
      el.addEventListener('focus', enter);
    });
    nav.addEventListener('pointerleave', () => { hovered = null; retarget(); });
    nav.addEventListener('focusout', (e) => {
      if (!nav.contains(e.relatedTarget as Node)) { hovered = null; retarget(); }
    });
    nav.addEventListener('scroll', retarget, { passive: true });
  });
  }

  // astro:page-load fires on the initial load and after every view transition.
  document.addEventListener('astro:page-load', initPmenu);
</script>
