---
/**
 * The one project menu, shared by the home hero and every case-study rail so
 * the site's primary navigation is identical everywhere. Plain text items; on
 * hover/focus (or when it's the current project) the title takes the accent
 * colour and an underline grows in, while a soft gradient spotlight eases
 * behind it. `variant` only changes how the column is placed (the home menu
 * fills its column; the rail sticks) — the items look and behave the same.
 * The glow picks up whatever `--accent` is in scope, so on a case page it takes
 * that project's colour.
 */
import { projectHref, type Project } from '../lib/projects';

interface Props {
  projects: Project[];
  current?: string;
  variant?: 'hero' | 'rail';
}
const { projects, current, variant = 'hero' } = Astro.props;
---
<nav class:list={['pmenu', `pmenu--${variant}`]} aria-label="Projects" data-pmenu>
  <!-- Gradient spotlight that chases the active item (decorative; see script). -->
  <span class="pmenu__glow" data-glow aria-hidden="true"></span>
  {projects.map((p, i) => (
    <a
      class:list={['pmenu__item', { active: p.id === current }]}
      href={projectHref(p)}
      data-item
      aria-current={p.id === current ? 'page' : undefined}
      style={`--i:${i}`}
    >
      <span class="pmenu__name">{p.data.title}</span>
      {p.data.wip && <span class="pmenu__soon">Soon</span>}
    </a>
  ))}
</nav>

<style>
  .pmenu {
    position: relative; /* containing block for the spotlight */
    display: flex;
    flex-direction: column;
    gap: 2px;
    overflow-y: auto;
    scrollbar-width: none; /* Firefox */
    /* Shared item metrics — identical in both contexts. */
    --pmenu-fs: 1.12rem;
    --pmenu-pad: 7px 12px;
    padding: 26px 18px 26px 30px;
  }
  .pmenu::-webkit-scrollbar { display: none; } /* Chromium/WebKit */

  /* ── Variant = column placement only (items are the same) ────────────── */
  .pmenu--hero {
    flex: 1 1 auto;
    min-height: 0;
  }
  .pmenu--rail {
    position: sticky;
    top: var(--nav-h); /* clears the sticky top nav */
    max-height: calc(100vh - var(--nav-h));
  }

  /* ── Gradient spotlight ─────────────────────────────────────────────── */
  .pmenu__glow {
    position: absolute;
    left: 8px;
    right: 8px;
    top: 0; /* JS drives translateY relative to the scroll area */
    height: 0;
    opacity: 0;
    border-radius: 12px;
    pointer-events: none;
    z-index: 0;
    background:
      radial-gradient(120% 80% at 6% 50%,
        color-mix(in srgb, var(--accent) 22%, transparent) 0%,
        color-mix(in srgb, var(--accent) 9%, transparent) 46%,
        transparent 78%);
    will-change: transform, height, opacity;
  }

  /* ── Item ───────────────────────────────────────────────────────────── */
  .pmenu__item {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding: var(--pmenu-pad);
    text-decoration: none;
    color: inherit;
    border-radius: 12px;
  }
  /* Signature: staggered rise on first paint (home only). */
  .pmenu--hero .pmenu__item {
    opacity: 0;
    animation: pmenu-rise 0.6s var(--ease-out, ease) both;
    animation-delay: calc(120ms + var(--i) * 65ms);
  }
  @keyframes pmenu-rise {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .pmenu__name {
    position: relative;
    font-weight: 600;
    font-size: var(--pmenu-fs);
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--muted);
    transition: color var(--dur-1, 0.18s) var(--ease-out, ease);
  }
  /* Animated underline — grows left→right on hover/focus/active. */
  .pmenu__name::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-2, 0.32s) var(--ease-out, ease);
  }
  /* Hover, focus, and current-project all resolve to the same accented state,
     so the colour is correct regardless of whether the item is selected. */
  .pmenu__item:hover .pmenu__name,
  .pmenu__item:focus-visible .pmenu__name,
  .pmenu__item.active .pmenu__name { color: var(--accent); }
  .pmenu__item:hover .pmenu__name::after,
  .pmenu__item:focus-visible .pmenu__name::after,
  .pmenu__item.active .pmenu__name::after { transform: scaleX(1); }

  /* "Soon" chip (e.g. Talaris) */
  .pmenu__soon {
    align-self: center;
    padding: 3px 9px;
    border-radius: 999px;
    background: color-mix(in srgb, currentColor 10%, transparent);
    color: var(--muted);
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
</style>

<script>
  // Gradient spotlight: a soft glow eases toward whichever item is hovered or
  // focused. On the rail it rests on the current project until you hover.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-pmenu]').forEach((nav) => {
    const glow = nav.querySelector<HTMLElement>('[data-glow]');
    const items = Array.from(nav.querySelectorAll<HTMLElement>('[data-item]'));
    if (!glow || !items.length) return;
    const rest = nav.querySelector<HTMLElement>('[data-item].active');

    const place = (el: HTMLElement) => {
      glow!.style.transform = `translateY(${el.offsetTop - nav.scrollTop}px)`;
      glow!.style.height = `${el.offsetHeight}px`;
    };

    if (reduce) {
      // No motion: pin a static highlight on the active item, if any.
      if (rest) { place(rest); glow.style.opacity = '0.5'; }
      return;
    }

    let hovered: HTMLElement | null = null;
    let raf = 0;
    let cy = 0, ch = 0, op = 0;
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    const targetEl = () => hovered ?? rest ?? null;
    const targetOp = () => (hovered ? 1 : rest ? 0.5 : 0);

    function frame() {
      const el = targetEl();
      const ty = el ? el.offsetTop - nav.scrollTop : cy;
      const th = el ? el.offsetHeight : ch;
      const to = targetOp();
      cy = lerp(cy, ty, 0.22);
      ch = lerp(ch, th, 0.22);
      op = lerp(op, to, 0.18);
      glow!.style.transform = `translateY(${cy}px)`;
      glow!.style.height = `${ch}px`;
      glow!.style.opacity = `${op}`;
      const done =
        Math.abs(op - to) < 0.005 &&
        Math.abs(cy - ty) < 0.4 &&
        Math.abs(ch - th) < 0.4;
      if (done) { raf = 0; return; }
      raf = requestAnimationFrame(frame);
    }
    const kick = () => { if (!raf) raf = requestAnimationFrame(frame); };

    // Snap onto the resting item (or the first) so it fades in place.
    const start = rest ?? items[0];
    cy = start.offsetTop - nav.scrollTop;
    ch = start.offsetHeight;
    kick();

    items.forEach((el) => {
      const enter = () => {
        if (!hovered && op < 0.02) { cy = el.offsetTop - nav.scrollTop; ch = el.offsetHeight; }
        hovered = el;
        kick();
      };
      el.addEventListener('pointerenter', enter);
      el.addEventListener('focus', enter);
    });
    nav.addEventListener('pointerleave', () => { hovered = null; kick(); });
    nav.addEventListener('focusout', (e) => {
      if (!nav.contains(e.relatedTarget as Node)) { hovered = null; kick(); }
    });
    nav.addEventListener('scroll', kick, { passive: true });
  });
</script>
