---
/**
 * The one project menu, shared by the home hero and every case-study rail so
 * the site's primary navigation is identical everywhere. Text-only items; on
 * hover/focus the title underlines and a drop-down reveals the category + a few
 * keywords, while a soft gradient spotlight eases behind the active item.
 *
 * `variant` only scales spacing/type to the context — the interaction is one
 * and the same. `current` marks the open project (rail), where the spotlight
 * rests until you hover elsewhere. The glow picks up whatever `--accent` is in
 * scope, so on a case page it takes that project's colour.
 */
import { categories } from '@config/site';
import { projectHref, type Project } from '../lib/projects';

interface Props {
  projects: Project[];
  current?: string;
  variant?: 'hero' | 'rail';
}
const { projects, current, variant = 'hero' } = Astro.props;

const catLabel = (id: string) => categories.find((c) => c.id === id)?.label ?? id;

// A few keywords surfaced in each item's drop-down. Prefer the project's
// tools; fall back to the year so the panel is never empty.
const keywordsFor = (p: Project) => {
  const picks = (p.data.tools ?? []).slice(0, 3);
  if (picks.length === 0 && p.data.year) picks.push(String(p.data.year));
  return picks;
};
---
<nav class:list={['pmenu', `pmenu--${variant}`]} aria-label="Projects" data-pmenu>
  <!-- Gradient spotlight that chases the active item (decorative; see script). -->
  <span class="pmenu__glow" data-glow aria-hidden="true"></span>
  {projects.map((p, i) => (
    <a
      class:list={['pmenu__item', { active: p.id === current }]}
      href={projectHref(p)}
      data-item
      aria-current={p.id === current ? 'page' : undefined}
      style={`--i:${i}`}
    >
      <span class="pmenu__head">
        <span class="pmenu__name">{p.data.title}</span>
        {p.data.wip && <span class="pmenu__soon">Soon</span>}
      </span>
      <span class="pmenu__panel">
        <span class="pmenu__panel-inner">
          <span class="pmenu__cat">{catLabel(p.data.category)}</span>
          {keywordsFor(p).map((k) => (
            <span class="pmenu__kw">{k}</span>
          ))}
        </span>
      </span>
    </a>
  ))}
</nav>

<style>
  .pmenu {
    position: relative; /* containing block for the spotlight */
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    scrollbar-width: none; /* Firefox */
  }
  .pmenu::-webkit-scrollbar { display: none; } /* Chromium/WebKit */

  /* ── Variant layout ─────────────────────────────────────────────────── */
  .pmenu--hero {
    flex: 1 1 auto;
    min-height: 0;
    gap: 2px;
    /* Left padding = 30px so the column aligns with the header name. */
    padding: 2rem 20px 2rem 30px;
    --pmenu-fs: clamp(1.5rem, 2.6vw, 2.15rem);
    --pmenu-pad: 10px 14px;
  }
  .pmenu--rail {
    position: sticky;
    top: var(--nav-h); /* clears the sticky top nav */
    max-height: calc(100vh - var(--nav-h));
    gap: 2px;
    padding: 26px 18px 26px 30px;
    --pmenu-fs: 1.12rem;
    --pmenu-pad: 7px 12px;
  }

  /* ── Gradient spotlight ─────────────────────────────────────────────── */
  .pmenu__glow {
    position: absolute;
    left: 8px;
    right: 8px;
    top: 0; /* JS drives translateY relative to the scroll area */
    height: 0;
    opacity: 0;
    border-radius: 14px;
    pointer-events: none;
    z-index: 0;
    background:
      radial-gradient(120% 80% at 6% 50%,
        color-mix(in srgb, var(--accent) 22%, transparent) 0%,
        color-mix(in srgb, var(--accent) 9%, transparent) 46%,
        transparent 78%);
    will-change: transform, height, opacity;
  }

  /* ── Item ───────────────────────────────────────────────────────────── */
  .pmenu__item {
    position: relative;
    z-index: 1;
    display: block;
    padding: var(--pmenu-pad);
    text-decoration: none;
    color: inherit;
    border-radius: 14px;
  }
  /* Signature: staggered rise on first paint (hero only). */
  .pmenu--hero .pmenu__item {
    opacity: 0;
    animation: pmenu-rise 0.65s var(--ease-out, ease) both;
    animation-delay: calc(120ms + var(--i) * 65ms);
  }
  @keyframes pmenu-rise {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .pmenu__head { display: flex; align-items: baseline; gap: 12px; }
  .pmenu__name {
    position: relative;
    font-weight: 600;
    font-size: var(--pmenu-fs);
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: var(--muted);
    transition: color var(--dur-2, 0.3s) var(--ease-out, ease);
  }
  /* Animated underline — grows left→right on hover/focus. */
  .pmenu__name::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-2, 0.35s) var(--ease-out, ease);
  }
  .pmenu__item:hover .pmenu__name,
  .pmenu__item:focus-visible .pmenu__name { color: var(--text); }
  .pmenu__item:hover .pmenu__name::after,
  .pmenu__item:focus-visible .pmenu__name::after { transform: scaleX(1); }

  /* Current project (rail): stays accented + underlined. */
  .pmenu__item.active .pmenu__name { color: var(--accent); }
  .pmenu__item.active .pmenu__name::after { transform: scaleX(1); }

  /* "Soon" chip (e.g. Talaris) */
  .pmenu__soon {
    align-self: center;
    padding: 3px 9px;
    border-radius: 999px;
    background: color-mix(in srgb, currentColor 10%, transparent);
    color: var(--muted);
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Drop-down — opens via the 0fr → 1fr grid-rows technique. */
  .pmenu__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--dur-3, 0.4s) var(--ease-out, ease);
  }
  .pmenu__panel-inner {
    overflow: hidden;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding-top: 0;
    opacity: 0;
    transform: translateY(-4px);
    transition:
      opacity var(--dur-2, 0.3s) var(--ease-out, ease) 0.05s,
      transform var(--dur-2, 0.3s) var(--ease-out, ease) 0.05s,
      padding-top var(--dur-3, 0.4s) var(--ease-out, ease);
  }
  .pmenu__item:hover .pmenu__panel,
  .pmenu__item:focus-visible .pmenu__panel { grid-template-rows: 1fr; }
  .pmenu__item:hover .pmenu__panel-inner,
  .pmenu__item:focus-visible .pmenu__panel-inner {
    opacity: 1;
    transform: translateY(0);
    padding-top: 10px;
  }

  .pmenu__cat {
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-text, #fff);
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }
  .pmenu__kw {
    padding: 4px 11px;
    border-radius: 999px;
    border: 1px solid var(--border);
    color: var(--muted);
    font-size: 12px;
    white-space: nowrap;
  }
</style>

<script>
  // Gradient spotlight: a soft glow eases toward whichever item is hovered or
  // focused, re-reading the target every frame so it grows in sync with the
  // drop-down. On the rail it rests on the current project until you hover.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-pmenu]').forEach((nav) => {
    const glow = nav.querySelector<HTMLElement>('[data-glow]');
    const items = Array.from(nav.querySelectorAll<HTMLElement>('[data-item]'));
    if (!glow || !items.length) return;
    const rest = nav.querySelector<HTMLElement>('[data-item].active');

    const place = (el: HTMLElement) => {
      glow!.style.transform = `translateY(${el.offsetTop - nav.scrollTop}px)`;
      glow!.style.height = `${el.offsetHeight}px`;
    };

    if (reduce) {
      // No motion: pin a static highlight on the active item, if any.
      if (rest) { place(rest); glow.style.opacity = '0.5'; }
      return;
    }

    let hovered: HTMLElement | null = null;
    let raf = 0;
    let cy = 0, ch = 0, op = 0;
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    const targetEl = () => hovered ?? rest ?? null;
    const targetOp = () => (hovered ? 1 : rest ? 0.5 : 0);

    function frame() {
      const el = targetEl();
      const ty = el ? el.offsetTop - nav.scrollTop : cy;
      const th = el ? el.offsetHeight : ch;
      const to = targetOp();
      cy = lerp(cy, ty, 0.22);
      ch = lerp(ch, th, 0.22);
      op = lerp(op, to, 0.18);
      glow!.style.transform = `translateY(${cy}px)`;
      glow!.style.height = `${ch}px`;
      glow!.style.opacity = `${op}`;
      const done =
        Math.abs(op - to) < 0.005 &&
        Math.abs(cy - ty) < 0.4 &&
        Math.abs(ch - th) < 0.4;
      if (done) { raf = 0; return; }
      raf = requestAnimationFrame(frame);
    }
    const kick = () => { if (!raf) raf = requestAnimationFrame(frame); };

    // Snap onto the resting item (or the first) so it fades in place.
    const start = rest ?? items[0];
    cy = start.offsetTop - nav.scrollTop;
    ch = start.offsetHeight;
    kick();

    items.forEach((el) => {
      const enter = () => {
        // Fading in from nothing: appear at the item, not sliding from the top.
        if (!hovered && op < 0.02) { cy = el.offsetTop - nav.scrollTop; ch = el.offsetHeight; }
        hovered = el;
        kick();
      };
      el.addEventListener('pointerenter', enter);
      el.addEventListener('focus', enter);
    });
    nav.addEventListener('pointerleave', () => { hovered = null; kick(); });
    nav.addEventListener('focusout', (e) => {
      if (!nav.contains(e.relatedTarget as Node)) { hovered = null; kick(); }
    });
    nav.addEventListener('scroll', kick, { passive: true });
  });
</script>
