---
/**
 * Sticky left project-nav rail for case-study pages. It's the same ProjectMenu
 * that powers the home hero — text items, hover drop-down, and a gradient
 * spotlight that here rests on the current project — just scaled to the rail
 * (`variant="rail"`). Keeping one component means the home and in-project
 * navigation are identical by construction. The glow inherits the case shell's
 * `--accent`, so it takes on each project's colour.
 */
import ProjectMenu from './ProjectMenu.astro';
import type { Project } from '../lib/projects';

interface Props {
  projects: Project[];
  current: string;
  dark?: boolean;
}
const { projects, current, dark = false } = Astro.props;
---
<aside class:list={['rail', { dark }]}>
  <ProjectMenu projects={projects} current={current} variant="rail" />
</aside>

<style>
  /* The rail is always the light chrome panel — even when the case canvas is
     dark (Grab) — so it reads as a persistent, open sidebar. */
  .rail {
    flex: 0 0 264px;
    align-self: stretch;
    border-right: 1px solid var(--border);
    background: var(--bg);
    color: var(--text);
  }

  /* Rail collapses on narrow viewports — the top Nav covers wayfinding. */
  @media (max-width: 900px) {
    .rail { display: none; }
  }
</style>
