---
/**
 * Chlo' — light-theme product case study, ported from the Figma "chlo demo"
 * page (node 114:1129). Self-contained: renders its own hero (the [slug]
 * template drops ProjectHeader via `hideHeader: true`).
 *
 * The heavy positioned diagrams (leader-line callouts + exploded assembly
 * views) are exported flat from Figma as PNGs — labels and leader lines are
 * baked into the render, per PORTING_GUIDE.md §6. They are NOT rebuilt in CSS.
 */
import { Image } from 'astro:assets';
import CaseScrollIndicator from './CaseScrollIndicator.astro';
import hero from '../../assets/chlo/hero.png';
import pool from '../../assets/chlo/pool.png';
import combatSketches from '../../assets/chlo/combat-sketches.png';
import step1 from '../../assets/chlo/step-1.png';
import step2 from '../../assets/chlo/step-2.png';
import step3 from '../../assets/chlo/step-3.png';
import step4 from '../../assets/chlo/step-4.png';
import calloutsTop from '../../assets/chlo/diagrams/callouts-top.png';
import explodedFeatures from '../../assets/chlo/diagrams/exploded-features.png';
import explodedParts from '../../assets/chlo/diagrams/exploded-parts.png';

const steps = [
  { img: step1, alt: 'Line sketch of a person extracting the chlorinator pod from the base and connecting the power cable', lead: 'Connect', body: ' the device to the power outlet and extract the chlorinator pod from the slot.' },
  { img: step2, alt: 'Line sketch of a person dropping the pod into the pool and selecting a power mode', lead: 'Drop', body: ' it in the pool and select a power mode to activate chlorine production.' },
  { img: step3, alt: 'Line sketch of a person storing the chlorinator pod back in its slot', lead: 'Store', body: ' the chlorinator pod back in the slot when entering the pool.' },
  { img: step4, alt: 'Line sketch of a person relaxing by the pool', lead: 'Enjoy', body: ' your pool.' },
];
---

<section class="chlo">
  <CaseScrollIndicator />

  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <header class="chlo-hero">
    <div class="chlo-inner chlo-hero__inner">
      <div class="chlo-hero__meta">
        <p>University Project — 2023</p>
        <p>Tools: Autodesk Solidworks, Keyshot, Vizcom</p>
      </div>
      <div class="chlo-hero__title">
        <h1>Chlo&rsquo;</h1>
        <p>Saving water with salt electrolysis conversion</p>
      </div>
    </div>
    <Image
      class="chlo-hero__img"
      src={hero}
      alt="Product render of the Chlo' pool chlorinator with its handle lifting the pod from the base"
      widths={[700, 1100, 1400]}
      sizes="(max-width: 900px) 100vw, 55vw"
    />
  </header>

  <!-- ── What is Chlo'? ───────────────────────────────────────────────── -->
  <div class="chlo-inner chlo-row chlo-row--what">
    <Image
      class="chlo-photo"
      src={pool}
      alt="A person relaxing at the edge of a small private pool"
      widths={[600, 900, 1200]}
      sizes="(max-width: 900px) 100vw, 45vw"
    />
    <div class="chlo-stack chlo-stack--lead">
      <h2 class="chlo-display">What is Chlo&rsquo;?</h2>
      <p>Chlo&rsquo; is an automatic salt pool chlorinator, built to extend the life of
        small-scale pools. It completely automates the process of chlorination using
        salt electrolysis, removing the need to cyclically empty the pool for
        maintenance.</p>
    </div>
  </div>

  <!-- ── Combat water waste ───────────────────────────────────────────── -->
  <div class="chlo-inner chlo-row chlo-row--combat">
    <div class="chlo-stack chlo-stack--lead">
      <h2 class="chlo-display">Combat water waste</h2>
      <p>Private pools can waste up to 50000 Liters of water every year, due to bad
        maintenance practice and seasonal changes.</p>
    </div>
    <Image
      class="chlo-sketches"
      src={combatSketches}
      alt="Concept line sketches exploring the form and proportions of the chlorinator"
      widths={[600, 900, 1200]}
      sizes="(max-width: 900px) 100vw, 45vw"
    />
  </div>

  <!-- ── Usage steps ──────────────────────────────────────────────────── -->
  <div class="chlo-inner chlo-steps">
    {steps.map((s) => (
      <figure class="chlo-step">
        <Image class="chlo-step__img" src={s.img} alt={s.alt} widths={[300, 600]} sizes="(max-width: 900px) 45vw, 22vw" />
        <figcaption><strong>{s.lead}</strong>{s.body}</figcaption>
      </figure>
    ))}
  </div>

  <!-- ── Callout diagram: features + controls (exported flat, baked labels) -->
  <div class="chlo-diagram chlo-diagram--full">
    <Image
      src={calloutsTop}
      alt="Exploded callout diagram of the pod. Titanium plates inside the pod are easily accessible for maintenance and cleaning; counter weights at the top ensure continuous floating during the salination process. The settings button offers Eco mode (low consumption for long periods of usage), Boost mode (for a deep cleaning) and Normal mode (for everyday use). Signal LEDs inform the current mode, signal correct functionality, and signal whether the amount of salt used is correct or if a top-up is needed."
      widths={[900, 1400, 1920]}
      sizes="100vw"
    />
  </div>

  <!-- ── Detailed exploded assembly (exported flat, baked labels) ─────── -->
  <div class="chlo-diagram chlo-diagram--full">
    <Image
      src={explodedFeatures}
      alt="Exploded assembly diagram of the outer shell. Built without glues, only screws and locking mechanisms; material thickness considered; electrical layout and IPS standards; rigidity rivets and reinforcement plates labelled on the components."
      widths={[900, 1400, 1920]}
      sizes="100vw"
    />
  </div>

  <!-- ── Full exploded parts breakdown (exported flat, baked labels) ──── -->
  <div class="chlo-inner chlo-diagram">
    <Image
      class="chlo-diagram__img"
      src={explodedParts}
      alt="Detailed exploded parts diagram labelling every component: Base PP, Cable support PP, Divider, Motherboard, Transformer, Button membrane, LED lights, Outer shell PP, Handle PP, Handle TPU, Weight Pb, Plate Ti, Chlorinator cap PP and Chlorinator shell PP."
      widths={[900, 1400, 1720]}
      sizes="(max-width: 900px) 100vw, 90vw"
    />
  </div>
</section>

<style>
  .chlo {
    --hair: rgba(20, 30, 50, 0.1);
    --body: rgba(20, 28, 44, 0.78);
    /* Match the off-white baked into the exported figure/render images so the
       image rectangles blend seamlessly into the page (no grey-on-white seam). */
    background: #e9e9f1;
    color: #141c2c;
    display: flex;
    flex-direction: column;
    gap: var(--case-gap);
    padding-bottom: var(--case-gap);
    width: 100%;
    overflow-x: clip;
  }

  .chlo-inner {
    width: 100%;
    max-width: var(--case-max);
    margin-inline: auto;
    padding-inline: var(--case-pad);
  }

  /* ── Hero ───────────────────────────────────────────────────────────── */
  .chlo-hero {
    position: relative;
    isolation: isolate;
    min-height: min(92vh, 900px);
    display: flex;
    align-items: center;
  }
  .chlo-hero__img {
    position: absolute;
    inset: 0 0 0 auto;
    width: min(60%, 900px);
    height: 100%;
    object-fit: contain;
    object-position: center right;
    z-index: -1;
  }
  .chlo-hero__inner {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(2rem, 8vw, 6rem);
    padding-block: clamp(2rem, 5vw, 4rem);
  }
  .chlo-hero__meta {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-weight: 300;
    font-size: var(--fs-small);
    color: var(--body);
  }
  .chlo-hero__title h1 {
    font-weight: 900;
    font-size: var(--fs-hero);
    line-height: 0.9;
    letter-spacing: -0.03em;
    margin: 0;
  }
  .chlo-hero__title p {
    margin-top: 0.6rem;
    font-weight: 700;
    font-size: clamp(1.15rem, 2.6vw, 2.25rem);
    max-width: 20ch;
  }

  /* ── Editorial rows ─────────────────────────────────────────────────── */
  .chlo-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 6.5rem);
    align-items: center;
  }
  .chlo-display {
    font-weight: 800;
    color: var(--accent);
    font-size: var(--fs-display);
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .chlo-stack {
    display: flex;
    flex-direction: column;
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }
  .chlo p {
    font-weight: 300;
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--body);
  }
  .chlo-stack--lead > p { font-size: clamp(1.05rem, 1.4vw, 1.5rem); }

  .chlo-photo,
  .chlo-sketches {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg, 20px);
  }
  .chlo-sketches { border-radius: var(--radius-md, 14px); }

  /* ── Usage steps ────────────────────────────────────────────────────── */
  .chlo-steps {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1rem, 3vw, 2.5rem);
    align-items: start;
  }
  /* Fixed-height image row + bottom-anchored figures so every ground line and
     caption lines up across the four columns, regardless of figure height. */
  .chlo-step {
    margin: 0;
    display: grid;
    grid-template-rows: clamp(220px, 26vw, 340px) auto;
    gap: 1.25rem;
  }
  .chlo-step__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
  }
  .chlo-step figcaption {
    font-weight: 300;
    font-size: var(--fs-small);
    line-height: 1.5;
    color: var(--body);
  }
  .chlo-step figcaption strong { color: var(--accent); font-weight: 700; }

  /* ── Diagrams (exported flat images) ────────────────────────────────── */
  .chlo-diagram { display: flex; justify-content: center; }
  /* Renderings are low-res, so cap their size — this both hides the low quality
     and lets the whole labelled diagram sit within one screen. */
  .chlo-diagram--full { width: 100%; }
  .chlo-diagram--full :global(img) {
    width: 100%;
    max-width: 1040px;
    margin-inline: auto;
    height: auto;
  }
  .chlo-diagram__img {
    width: 100%;
    max-width: 900px;
    height: auto;
    border-radius: var(--radius-lg, 20px);
  }

  /* ── Responsive ─────────────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .chlo-hero {
      min-height: 0;
      flex-direction: column;
    }
    .chlo-hero__img {
      position: static;
      width: 100%;
      height: auto;
      order: -1;
    }
    .chlo-row { grid-template-columns: 1fr; }
    /* Heading-first reading order on mobile for the "What is Chlo'?" row. */
    .chlo-row--what .chlo-stack--lead { order: -1; }
    .chlo-steps { grid-template-columns: repeat(2, 1fr); }
  }
</style>
