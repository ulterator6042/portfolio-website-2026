---
/**
 * Talaris — placeholder page. The case study is still under construction, so
 * the page mirrors the home hero (see index.astro): a single large, left-
 * aligned line, vertically centred beside the sidebar. Nothing else.
 */
---
<section class="wip" data-reveal-group>
  <h1 class="wip__title" data-reveal>Under construction!</h1>
</section>

<style>
  /* Match the home intro: fill the viewport height and centre a single line,
     left-aligned, using the base h1 style. */
  .wip {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(2rem, 6vw, 5rem);
  }
  .wip__title {
    max-width: 16ch;
    font-size: clamp(2.5rem, 6vw, 5rem);
    letter-spacing: -0.02em;
  }
</style>
