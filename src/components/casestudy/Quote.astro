---
interface Props { cite?: string }
const { cite } = Astro.props;
---
<blockquote class="cs-quote">
  <p><slot /></p>
  {cite && <cite>{cite}</cite>}
</blockquote>

<style>
  .cs-quote {
    max-width: 900px;
    margin: clamp(3rem, 7vw, 6rem) auto;
    padding-inline: var(--page-pad);
    text-align: center;
  }
  .cs-quote p {
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--text);
  }
  .cs-quote cite {
    display: block;
    margin-top: 1rem;
    font-style: normal;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent);
  }
</style>
