---
import { Image } from 'astro:assets';
/** A captioned image block. `bleed` = full-width; otherwise wide column.
 *  `src` accepts an imported image (preferred, gets optimized) or a string. */
interface Props {
  src: ImageMetadata | string;
  alt: string;
  caption?: string;
  bleed?: boolean;
}
const { src, alt, caption, bleed = false } = Astro.props;
const isImported = typeof src !== 'string';
---
<figure class:list={['cs-figure', { bleed }]}>
  {isImported
    ? <Image src={src as ImageMetadata} alt={alt} widths={[720, 1200, 1800]} sizes="(max-width: 1200px) 100vw, 1200px" />
    : <img src={src as string} alt={alt} loading="lazy" decoding="async" />}
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .cs-figure {
    max-width: var(--page-max);
    margin: clamp(2rem, 5vw, 4rem) auto;
    padding-inline: var(--page-pad);
  }
  .cs-figure.bleed { max-width: none; padding-inline: 0; }
  .cs-figure :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    background: var(--surface);
  }
  .cs-figure.bleed :global(img) { border-radius: 0; }
  figcaption {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: 0.85rem;
    font-family: var(--font-mono);
  }
</style>
