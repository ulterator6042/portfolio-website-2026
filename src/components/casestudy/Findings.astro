---
/** Editorial three-up findings grid. Each item: numbered, with a
 *  "What was good" and "Future work" pair. Minimal — thin rules, no shadows. */
interface Item { title: string; good: string; future: string; }
interface Props { items: Item[]; }
const { items } = Astro.props;
---
<div class="findings">
  {items.map((it, i) => (
    <article class="finding">
      <span class="finding__num">{String(i + 1).padStart(2, '0')}</span>
      <h3 class="finding__title">{it.title}</h3>
      <div class="finding__row">
        <p class="finding__label">What was good</p>
        <p class="finding__text">{it.good}</p>
      </div>
      <div class="finding__row">
        <p class="finding__label muted">Future work</p>
        <p class="finding__text muted">{it.future}</p>
      </div>
    </article>
  ))}
</div>

<style>
  .findings {
    max-width: var(--page-max);
    margin: clamp(2rem, 5vw, 4rem) auto;
    padding-inline: var(--page-pad);
    display: grid;
    gap: clamp(1.5rem, 3vw, 3rem);
    grid-template-columns: repeat(3, 1fr);
  }
  @media (max-width: 820px) { .findings { grid-template-columns: 1fr; } }
  .finding { border-top: 1px solid var(--text); padding-top: 1rem; }
  .finding__num { font-family: var(--font-mono); font-size: 0.8rem; color: var(--accent); }
  .finding__title { margin-top: 0.75rem; font-size: 1.25rem; }
  .finding__row { margin-top: 1.25rem; }
  .finding__label {
    font-family: var(--font-mono);
    font-size: 0.65rem; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--text);
  }
  .finding__label.muted { color: var(--muted); }
  .finding__text { margin-top: 0.4rem; font-size: 0.95rem; color: var(--text); }
  .finding__text.muted { color: var(--muted); }
</style>
