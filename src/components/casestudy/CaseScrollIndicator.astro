---
/**
 * Shared minimal scroll indicator for case-study pages — a slim fixed bar on
 * the right whose thumb height reflects how much of the page is visible and
 * whose position reflects scroll progress. Painted in the project accent
 * (`--accent`, injected on the case shell by [slug].astro).
 *
 * Drop one per project page: <CaseScrollIndicator />. Hidden ≤900px.
 */
---
<div class="case-scroll" aria-hidden="true"><div class="case-scroll__thumb"></div></div>

<style>
  .case-scroll {
    position: fixed;
    top: 12px;
    right: 6px;
    bottom: 10px;
    width: 5px;
    z-index: 40;
    border-radius: 999px;
    background: rgba(128, 128, 128, 0.16);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  .case-scroll__thumb {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    min-height: 40px;
    border-radius: 999px;
    background: var(--accent);
    will-change: transform, height;
  }
  @media (max-width: 900px) {
    .case-scroll { display: none; }
  }
</style>

<script>
  // Re-query on each navigation so the indicator survives client-side routing.
  let bar: HTMLElement | null = null;
  let thumb: HTMLElement | null = null;
  const update = () => {
    if (!bar || !thumb) return;
    const winH = window.innerHeight;
    const docH = document.documentElement.scrollHeight;
    const trackH = bar.clientHeight;
    const scrollable = docH - winH;
    if (scrollable <= 4) {
      bar.style.opacity = '0';
      return;
    }
    bar.style.opacity = '1';
    const thumbH = Math.max(40, trackH * (winH / docH));
    const scrolled = Math.min(1, Math.max(0, window.scrollY / scrollable));
    thumb.style.height = `${thumbH}px`;
    thumb.style.transform = `translateY(${scrolled * (trackH - thumbH)}px)`;
  };
  const refresh = () => {
    bar = document.querySelector<HTMLElement>('.case-scroll');
    thumb = document.querySelector<HTMLElement>('.case-scroll__thumb');
    update();
  };
  window.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update);
  document.addEventListener('astro:page-load', refresh);
</script>
