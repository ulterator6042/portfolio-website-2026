---
/**
 * Product Photography — full-bleed dark case study, ported from the Figma
 * "Product photography demo" page (node 87:1740). Image-forward: hero render
 * bleeding right, a 2×2 photo grid, and a closing pair of renders with caption.
 * Renders its own hero (the [slug] template drops ProjectHeader via hideHeader).
 * Copy verbatim from the deck (typos fixed).
 */
import { Image } from 'astro:assets';
import CaseScrollIndicator from './CaseScrollIndicator.astro';
import heroRender from '../../assets/product-photography/hero-render.png';
import closeLeft from '../../assets/product-photography/close-left.png';
import closeRight from '../../assets/product-photography/close-right.png';
import dsc9436 from '../../assets/product-photography/dsc9436.png';
import dsc9408 from '../../assets/product-photography/dsc9408.png';
import dsc9395 from '../../assets/product-photography/dsc9395.png';
import dsc9418 from '../../assets/product-photography/dsc9418.png';

const grid = [
  { src: dsc9436, alt: 'Behind the scenes — the goggles lit on a red studio set' },
  { src: dsc9408, alt: 'The goggles under blue and magenta gel lighting' },
  { src: dsc9395, alt: 'Close product shot of the goggles in red light' },
  { src: dsc9418, alt: 'The goggles backlit in blue' },
];
---

<section class="pp">
  <CaseScrollIndicator />

  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <header class="pp-hero">
    <Image
      class="pp-hero__render"
      src={heroRender}
      alt="Neon-lit render of the goggles in blue and magenta on black"
      widths={[600, 929, 1400]}
      sizes="(max-width: 900px) 100vw, 52vw"
    />
    <div class="pp-inner pp-hero__text" data-reveal-group>
      <div class="pp-hero__meta">
        <p data-reveal>University Project - 2023</p>
        <p data-reveal>Tools: Adobe Lightroom, Keyshot, Alias 3D</p>
      </div>
      <div class="pp-hero__title">
        <h1 data-reveal>Product<br />photography</h1>
        <p data-reveal>Creative product advertisement picture and rendering exercise</p>
      </div>
    </div>
  </header>

  <!-- ── 2×2 photo grid ───────────────────────────────────────────────── -->
  <div class="pp-grid" data-reveal-group>
    {grid.map((g) => (
      <Image data-reveal class="pp-grid__img" src={g.src} alt={g.alt} widths={[720, 1200, 1920]} sizes="(max-width: 720px) 100vw, 50vw" />
    ))}
  </div>

  <!-- ── Closing render pair ──────────────────────────────────────────── -->
  <div class="pp-close">
    <div class="pp-inner pp-close__pair" data-reveal-group>
      <Image data-reveal class="pp-close__img" src={closeLeft} alt="Render of the goggles lit blue and magenta, three-quarter view" widths={[600, 800, 1200]} sizes="(max-width: 900px) 100vw, 50vw" />
      <Image data-reveal class="pp-close__img" src={closeRight} alt="Render of the goggles lit blue and magenta, alternate angle" widths={[600, 800, 1200]} sizes="(max-width: 900px) 100vw, 50vw" />
    </div>
    <p class="pp-inner pp-close__caption" data-reveal>Model created with Alias 3D, renderings made with Keyshot 12.</p>
  </div>
</section>

<style>
  .pp {
    --ink: #0e0a10;
    --body: rgba(255, 255, 255, 0.82);
    background: var(--ink);
    color: #fff;
    display: flex;
    flex-direction: column;
    gap: var(--case-gap);
    padding-bottom: var(--case-gap);
    width: 100%;
    overflow-x: clip;
  }
  .pp-inner {
    width: 100%;
    max-width: var(--case-max);
    margin-inline: auto;
    padding-inline: var(--case-pad);
  }

  /* ── Hero: text left, render bleeding to the right edge ──────────────── */
  .pp-hero {
    position: relative;
    isolation: isolate;
    min-height: min(86vh, 860px);
    display: flex;
    align-items: center;
  }
  .pp-hero__render {
    position: absolute;
    top: 50%;
    right: 0;
    transform: translateY(-50%);
    width: min(52%, 1000px);
    height: auto;
    object-fit: contain;
    z-index: -1;
  }
  .pp-hero__text {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 5vw, 3.5rem);
  }
  .pp-hero__meta {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-weight: 300;
    font-size: var(--fs-small);
    color: rgba(255, 255, 255, 0.85);
  }
  .pp-hero__title h1 {
    font-weight: 900;
    font-size: clamp(3rem, 8vw, 8rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin: 0;
  }
  .pp-hero__title p {
    margin-top: 0.75rem;
    font-weight: 700;
    font-size: clamp(1.15rem, 2.4vw, 2.25rem);
    max-width: 22ch;
  }

  /* ── Photo grid ─────────────────────────────────────────────────────── */
  .pp-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0; }
  .pp-grid__img { width: 100%; height: clamp(220px, 30vw, 540px); object-fit: cover; display: block; }

  /* ── Closing pair ───────────────────────────────────────────────────── */
  .pp-close {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  .pp-close__pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(1.5rem, 4vw, 3.5rem);
  }
  .pp-close__img { width: 100%; height: auto; }
  .pp-close__caption { color: var(--body); font-weight: 300; font-size: var(--fs-small); }

  /* ── Responsive ─────────────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .pp-hero { min-height: 0; flex-direction: column; align-items: stretch; padding-top: 2rem; }
    .pp-hero__render { position: static; transform: none; width: 100%; order: 1; margin-top: 1.5rem; }
    .pp-hero__text { order: 0; }
    .pp-close__pair { grid-template-columns: 1fr; }
  }
  @media (max-width: 720px) {
    .pp-grid { grid-template-columns: 1fr; }
  }
</style>
