---
/** Generic vertical rhythm wrapper for a case-study block.
 *  `wide` breaks out of the reading column; `bleed` goes full-viewport. */
interface Props { wide?: boolean; bleed?: boolean; }
const { wide = false, bleed = false } = Astro.props;
---
<section class:list={['cs-section', { wide, bleed }]}>
  <slot />
</section>

<style>
  .cs-section {
    max-width: 720px;
    margin-inline: auto;
    padding-inline: var(--page-pad);
    margin-block: clamp(2.5rem, 6vw, 5rem);
  }
  .cs-section.wide { max-width: var(--page-max); }
  .cs-section.bleed { max-width: none; padding-inline: 0; }
  .cs-section :global(p) { color: var(--muted); font-size: 1.05rem; }
  .cs-section :global(p + p) { margin-top: 1.25rem; }
</style>
