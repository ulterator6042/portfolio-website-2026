---
/**
 * Logitech Mind — light-theme thesis case study, ported from the Figma "Mind
 * demo" page (node 87:2190). Self-contained hero (hideHeader: true).
 *
 * The circular "×25" cycle diagram is an exported flat PNG. The user-journey map
 * is a bespoke chart (phase timeline · Without/With lanes with emotion tags ·
 * momentum bars) rebuilt from the Figma "Journey Map — With vs Without" frame.
 */
import { Image } from 'astro:assets';
import CaseScrollIndicator from './CaseScrollIndicator.astro';
import CaseVideo from './CaseVideo.astro';
import laptop from '../../assets/mind/hero-laptop.png';
import marks from '../../assets/mind/marks.png';
import cycle from '../../assets/mind/diagrams/cycle.png';

const priorities = [
  { need: 'Speed of Interaction', answer: 'One trigger interaction' },
  { need: 'Ease of resumption', answer: 'Welcome back card info' },
  { need: 'Depth of detail capture', answer: 'Full context snapshot' },
  { need: 'Ability to save multiple contexts', answer: 'Save work for later' },
  { need: 'Control over what is saved', answer: 'User confirmed trigger' },
  { need: 'Privacy and data handling', answer: 'locally stored information' },
];

// ── User-journey map data (from Figma node 87:2060) ──────────────────────────
const phases = ['Deep Focus', 'The Slip', 'Handling It', 'Return', 'Re-entry', 'Resumption'];

const withoutLane = [
  { text: 'Deep in the task, holding a fragile mental model.', emotion: 'Focused', tone: 'neutral' },
  { text: 'Interruption hits. They drop everything — no time to note anything.', emotion: 'Startled', tone: 'bad' },
  { text: 'Mind trying to keep track of main task; tabs and windows pile up.', emotion: 'Torn', tone: 'bad' },
  { text: 'A messy desktop, scattered windows, debris tabs.', emotion: 'Overwhelmed', tone: 'bad' },
  { text: 'Manual reconstruction: Re-reads, repositions, closes tabs.', emotion: 'Frustrated', tone: 'bad' },
  { text: 'Momentum rebuilds slowly time and energy already lost.', emotion: 'Depleted', tone: 'warn' },
];

const withLane = [
  { text: 'Same deep focus, the tool captures context silently in the background.', emotion: 'Focused, secure', hl: false },
  { text: 'One quick trigger stores the full context. Nothing to write down.', emotion: 'Calm, in control', hl: true },
  { text: 'Attends to the interruption freely, the system watches what changes.', emotion: 'Present', hl: false },
  { text: 'One trigger, and the workspace rebuilds itself. Debris cleared.', emotion: 'Relief', hl: true },
  { text: 'The welcome-back card restores context at a glance.', emotion: 'Oriented', hl: true },
  { text: 'Resumes right where they left off — back in flow.', emotion: 'Confident', hl: false },
];

const momentumWithout = [
  { h: 100, tone: 'good' }, { h: 82, tone: 'warn' }, { h: 34, tone: 'bad' },
  { h: 16, tone: 'bad' }, { h: 37, tone: 'bad' }, { h: 68, tone: 'warn' },
];
const momentumWith = [
  { h: 100, tone: 'good' }, { h: 79, tone: 'warn' }, { h: 34, tone: 'bad' },
  { h: 17, tone: 'bad' }, { h: 84, tone: 'warn' }, { h: 100, tone: 'good' },
];

const outcomes = [
  {
    n: '01',
    title: 'Window restoration vs Welcome back card',
    good: 'The restoration of windows is an instant memory trigger, well valued by the professionals.',
    future: 'The welcome back card has a high learning curve and can be confusing at first; needs more research on what data can help workers.',
  },
  {
    n: '02',
    title: 'Ghost interface',
    good: 'The interface is unobtrusive, it does not distract you while you are focused on your tasks.',
    future: 'The interface risks lowering the user’s engagement; it needs exploration of different methods to ensure engagement while maintaining a low profile.',
  },
  {
    n: '03',
    title: 'Gestures and hardware',
    good: 'Users responded well to the possibility of adapting the trigger signal to their own preference.',
    future: 'Full integration with Logitech’s physical products is only a theoretical application; more exploration of the specific gestures available will unlock even more customization.',
  },
];
---

<section class="mind">
  <CaseScrollIndicator />

  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <header class="mind-hero">
    <div class="mind-inner mind-hero__grid" data-reveal-group>
      <div class="mind-hero__meta">
        <p data-reveal>Thesis project</p>
        <p data-reveal>Tools: Figma, Claude Code, Python</p>
      </div>
      <Image class="mind-hero__marks" src={marks} alt="TU Delft × Logitech" widths={[300, 600]} sizes="260px" />
      <div class="mind-hero__title">
        <h1 data-reveal><span class="mind-hero__logi">logitech</span><span class="mind-hero__brand">Mind</span></h1>
        <p data-reveal>Better recovery from workplace interruptions</p>
      </div>
      <Image
        data-reveal
        class="mind-hero__laptop"
        src={laptop}
        alt="A laptop showing the Mind interruption-manager interface capturing an active work session"
        widths={[700, 1100, 1400]}
        sizes="(max-width: 900px) 100vw, 50vw"
      />
    </div>
  </header>

  <!-- ── What is Logitech Mind? ───────────────────────────────────────── -->
  <div class="mind-inner mind-stack mind-stack--lead" data-reveal-group>
    <h2 class="mind-display" data-reveal>What is Logitech Mind?</h2>
    <p data-reveal>Mind is a desktop tool that helps workers <strong>recover from interruptions.</strong>
      One trigger captures everything you were working on, one trigger brings it all back;
      <strong>rebuilding your context in seconds.</strong></p>
  </div>

  <!-- ── Interruptions are inevitable · cycle diagram ─────────────────── -->
  <div class="mind-inner mind-row mind-row--cycle" data-reveal-group>
    <div class="mind-stack mind-stack--lead">
      <h2 class="mind-display" data-reveal>Interruptions are inevitable.</h2>
      <p data-reveal>The average worker goes through 25 cycles of focus, interruption and re-entry in
        a single day, losing the precious momentum they had built while focusing on a
        task. <strong>The biggest energy cost is in the re-entry.</strong></p>
    </div>
    <Image
      data-reveal
      class="mind-cycle"
      src={cycle}
      alt="A cycle repeated 25 times a day: Focused work → Trigger → Interruption → Resolution → Re-entry, and back to focused work."
      widths={[500, 800, 1000]}
      sizes="(max-width: 900px) 100vw, 45vw"
    />
  </div>

  <!-- ── Working prototype · video ────────────────────────────────────── -->
  <div class="mind-inner mind-row mind-row--demo" data-reveal-group>
    <CaseVideo src="/media/mind.mp4" />
    <div class="mind-stack mind-stack--lead">
      <h2 class="mind-display" data-reveal>Working prototype</h2>
      <p data-reveal><strong>One trigger</strong> saves everything you were doing before an interruption;
        one trigger brings it all back.</p>
      <p data-reveal>It <strong>rebuilds your context</strong> and reminds you where you left off, so
        <strong>returning to work costs seconds instead of minutes.</strong></p>
    </div>
  </div>

  <!-- ── Priority to constraints · ranked survey mapping ──────────────── -->
  <div class="mind-inner mind-priorities" data-reveal-group>
    <div class="mind-priorities__head">
      <h2 class="mind-display" data-reveal>Priority to constraints</h2>
      <p class="mind-note">*153 survey samples</p>
    </div>
    <div class="mind-prio">
      <div class="mind-prio__rail" aria-hidden="true"></div>
      <ol class="mind-prio__rows">
        {priorities.map((p) => (
          <li class="mind-prio__row" data-reveal>
            <span class="mind-prio__pill">{p.need}</span>
            <span class="mind-prio__arrow" aria-hidden="true">→</span>
            <span class="mind-prio__pill mind-prio__pill--answer">{p.answer}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>

  <!-- ── User journey map · bespoke With/Without chart ────────────────── -->
  <div class="mind-inner mind-journey" data-reveal-group>
    <h2 class="mind-display" data-reveal>User journey map</h2>
    <div class="mind-jscroll" data-reveal>
      <div class="mind-jmap">
        <!-- Phase timeline -->
        <div></div>
        {phases.map((name, i) => (
          <div class="mind-jmap__phase">
            <span class="mind-jmap__badge">{i + 1}</span>
            <b>{name}</b>
          </div>
        ))}

        <!-- Without lane -->
        <div class="mind-jmap__rowlabel">
          <b>Without the tool</b><span>the current reality</span>
        </div>
        {withoutLane.map((c) => (
          <article class="mind-jcard">
            <p>{c.text}</p>
            <span class="mind-jcard__emo">
              <span class={`mind-jcard__dot tone-${c.tone}`}></span>{c.emotion}
            </span>
          </article>
        ))}

        <!-- Without momentum -->
        <div class="mind-jmap__rowlabel">
          <b>Momentum</b><span>deep valley, slow climb</span>
        </div>
        {momentumWithout.map((m) => (
          <div class="mind-jbar"><span class={`tone-${m.tone}`} style={`height:${m.h}%`}></span></div>
        ))}

        <!-- With lane -->
        <div class="mind-jmap__rowlabel mind-jmap__rowlabel--accent">
          <b>With the tool</b><span>using the prototype</span>
        </div>
        {withLane.map((c) => (
          <article class={`mind-jcard${c.hl ? ' mind-jcard--hl' : ''}`}>
            <p>{c.text}</p>
            <span class="mind-jcard__emo">
              <span class="mind-jcard__dot tone-good"></span>{c.emotion}
            </span>
          </article>
        ))}

        <!-- With momentum -->
        <div class="mind-jmap__rowlabel">
          <b>Momentum</b><span>quicker recovery</span>
        </div>
        {momentumWith.map((m) => (
          <div class="mind-jbar"><span class={`tone-${m.tone}`} style={`height:${m.h}%`}></span></div>
        ))}
      </div>
    </div>
  </div>

  <!-- ── Evaluation outcome · bespoke 3-card grid ─────────────────────── -->
  <div class="mind-inner mind-outcome" data-reveal-group>
    <h2 class="mind-display" data-reveal>Evaluation outcome</h2>
    <div class="mind-cards">
      {outcomes.map((o) => (
        <article class="mind-card" data-reveal>
          <span class="mind-card__num">{o.n}</span>
          <h3>{o.title}</h3>
          <div class="mind-card__rule"></div>
          <div class="mind-card__split">
            <span class="mind-card__label">What was good</span>
            <p>{o.good}</p>
          </div>
          <div class="mind-card__split">
            <span class="mind-card__label mind-card__label--muted">Future work</span>
            <p class="mind-card__future">{o.future}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .mind {
    --card: #ffffff;
    --hair: rgba(30, 20, 60, 0.1);
    --body: rgba(24, 20, 40, 0.72);
    --ink: #141225;
    --warn: #e0a338;
    --bad: #e56540;
    --neutral: #9aa0ab;
    background: #f4f3f9;
    color: var(--ink);
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 6vw, 6rem);
    padding-bottom: clamp(3rem, 6vw, 6rem);
    width: 100%;
    overflow-x: clip;
  }

  .mind-inner {
    width: 100%;
    max-width: var(--case-max);
    margin-inline: auto;
    padding-inline: var(--case-pad);
  }

  /* ── Hero ───────────────────────────────────────────────────────────── */
  .mind-hero {
    /* Soft purple wash toward the bottom, matching the Figma hero gradient. */
    background: linear-gradient(180deg, #ffffff 0%, #fbfaff 42%, #e7e0f8 100%);
  }
  .mind-hero__grid {
    min-height: min(82vh, 820px);
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    grid-template-rows: auto 1fr;
    align-items: center;
    column-gap: clamp(1rem, 3vw, 3rem);
    padding-block: clamp(1.75rem, 3.5vw, 3rem);
  }
  .mind-hero__meta {
    grid-column: 1; grid-row: 1;
    align-self: start;
    display: flex; flex-direction: column; gap: 0.3rem;
    font-weight: 300; font-size: var(--fs-small); color: var(--body);
  }
  .mind-hero__marks {
    grid-column: 2; grid-row: 1;
    justify-self: end; align-self: start;
    width: clamp(120px, 13vw, 190px); height: auto;
  }
  .mind-hero__title { grid-column: 1; grid-row: 2; align-self: center; }
  .mind-hero__title h1 {
    display: flex; align-items: baseline; flex-wrap: wrap;
    font-weight: 900;
    font-size: clamp(2.5rem, 6.5vw, 5.75rem);
    line-height: 0.92; letter-spacing: -0.04em; margin: 0;
  }
  .mind-hero__logi { color: var(--ink); }
  .mind-hero__brand { color: var(--accent); }
  .mind-hero__title p {
    margin-top: 0.7rem; font-weight: 700;
    font-size: clamp(1.05rem, 2.2vw, 1.9rem); max-width: 24ch;
  }
  .mind-hero__laptop {
    grid-column: 2; grid-row: 2;
    justify-self: end; align-self: center;
    width: 100%; max-width: 860px; height: auto; object-fit: contain;
  }

  /* ── Display headings + text stacks ─────────────────────────────────── */
  .mind-display {
    font-weight: 800; color: var(--accent);
    font-size: var(--fs-display); line-height: 1.0;
    letter-spacing: -0.02em; margin: 0;
  }
  .mind-stack { display: flex; flex-direction: column; gap: clamp(1.25rem, 2.5vw, 2rem); }
  .mind p { font-weight: 300; font-size: var(--fs-body); line-height: 1.6; color: var(--body); }
  .mind-stack--lead > p { font-size: clamp(1.05rem, 1.4vw, 1.5rem); }
  .mind strong { font-weight: 700; color: var(--ink); }

  /* ── Two-column editorial rows ──────────────────────────────────────── */
  .mind-row {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 6.5rem); align-items: center;
  }
  .mind-cycle { width: 100%; height: auto; object-fit: contain; }
  .mind-row--demo { grid-template-columns: 1.1fr 0.9fr; }

  /* ── Priority to constraints ────────────────────────────────────────── */
  .mind-priorities { display: flex; flex-direction: column; gap: clamp(1.5rem, 3vw, 2.5rem); }
  .mind-priorities__head { display: flex; flex-direction: column; gap: 0.75rem; }
  .mind-note { font-weight: 500; font-size: var(--fs-small); color: var(--body); letter-spacing: 0.02em; }

  .mind-prio { display: grid; grid-template-columns: auto 1fr; gap: clamp(0.75rem, 1.6vw, 1.35rem); }
  .mind-prio__rail {
    width: 10px; border-radius: 999px;
    background: linear-gradient(to bottom, var(--accent), rgba(138, 115, 224, 0.12));
  }
  .mind-prio__rows {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-direction: column; gap: clamp(0.6rem, 1.4vw, 1.15rem);
  }
  .mind-prio__row {
    display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center; gap: clamp(0.75rem, 2vw, 1.75rem);
  }
  .mind-prio__pill {
    justify-self: start;
    background: var(--card); border-radius: 999px;
    padding: clamp(0.7rem, 1.3vw, 1rem) clamp(1.25rem, 2.2vw, 1.9rem);
    font-weight: 500; font-size: clamp(0.95rem, 1.15vw, 1.2rem);
    box-shadow: 0 12px 26px -16px rgba(30, 20, 60, 0.4);
  }
  .mind-prio__pill--answer { color: var(--body); }
  .mind-prio__arrow { justify-self: center; color: var(--body); font-size: 1.4rem; font-weight: 300; }

  /* ── User journey map ───────────────────────────────────────────────── */
  .mind-journey { display: flex; flex-direction: column; gap: clamp(1.5rem, 3vw, 2.5rem); }
  .mind-jscroll { overflow-x: auto; padding-bottom: 0.5rem; }
  .mind-jmap {
    min-width: 880px;
    display: grid;
    grid-template-columns: clamp(120px, 12vw, 168px) repeat(6, minmax(0, 1fr));
    gap: clamp(0.5rem, 0.9vw, 0.85rem);
    align-items: stretch;
  }
  .mind-jmap__rowlabel { align-self: center; display: flex; flex-direction: column; gap: 0.1rem; padding-right: 0.5rem; }
  .mind-jmap__rowlabel b { font-weight: 700; font-size: clamp(0.85rem, 1vw, 1rem); color: var(--ink); }
  .mind-jmap__rowlabel span { font-size: 0.72rem; color: var(--body); }
  .mind-jmap__rowlabel--accent b { color: var(--accent); }

  .mind-jmap__phase { display: flex; align-items: center; gap: 0.5rem; padding-bottom: 0.3rem; }
  .mind-jmap__badge {
    width: 26px; height: 26px; border-radius: 999px; flex: 0 0 auto;
    background: var(--accent); color: #fff; font-weight: 700; font-size: 0.8rem;
    display: grid; place-items: center;
  }
  .mind-jmap__phase b { font-weight: 700; font-size: clamp(0.85rem, 1vw, 1.05rem); }

  .mind-jcard {
    background: var(--card); border-radius: 14px;
    padding: clamp(0.7rem, 1.1vw, 1.05rem);
    display: flex; flex-direction: column; gap: 0.55rem;
    box-shadow: 0 10px 24px -18px rgba(30, 20, 60, 0.4);
  }
  .mind-jcard--hl { border: 1px solid rgba(138, 115, 224, 0.55); background: #f3f0fd; }
  .mind-jcard p { font-size: clamp(0.78rem, 0.9vw, 0.95rem); line-height: 1.4; margin: 0; color: var(--ink); font-weight: 400; }
  .mind-jcard__emo { display: flex; align-items: center; gap: 0.4rem; font-size: 0.72rem; color: var(--body); }
  .mind-jcard__dot { width: 9px; height: 9px; border-radius: 999px; flex: 0 0 auto; }

  .mind-jbar { display: flex; align-items: flex-end; justify-content: center; height: clamp(72px, 8vw, 118px); }
  .mind-jbar span { width: clamp(30px, 3.4vw, 54px); border-radius: 8px; min-height: 8px; }

  .tone-good { background: var(--accent); }
  .tone-warn { background: var(--warn); }
  .tone-bad { background: var(--bad); }
  .tone-neutral { background: var(--neutral); }

  /* ── Evaluation outcome cards ───────────────────────────────────────── */
  .mind-outcome { display: flex; flex-direction: column; gap: clamp(1.5rem, 3vw, 2.5rem); }
  .mind-cards {
    display: grid; grid-template-columns: repeat(3, 1fr);
    grid-template-rows: repeat(5, auto);
    column-gap: clamp(1.25rem, 2.5vw, 2rem);
    row-gap: clamp(0.75rem, 1.4vw, 1.15rem);
    align-items: stretch;
  }
  .mind-card {
    grid-row: span 5;
    display: grid; grid-template-rows: subgrid;
    background: var(--card);
    border-radius: var(--radius-lg, 20px); padding: clamp(1.5rem, 2.4vw, 2.25rem);
    box-shadow: 0 18px 40px -26px rgba(30, 20, 60, 0.4);
  }
  .mind-card__num { color: var(--accent); font-weight: 700; font-size: 0.95rem; }
  .mind-card h3 { font-weight: 700; font-size: clamp(1.15rem, 1.6vw, 1.5rem); line-height: 1.15; letter-spacing: -0.01em; margin: 0; }
  .mind-card__rule { height: 1px; background: var(--hair); margin: 0.25rem 0; }
  .mind-card__split { display: flex; flex-direction: column; gap: 0.35rem; }
  .mind-card__label { font-weight: 500; font-size: 0.7rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--accent); }
  .mind-card__label--muted { color: var(--body); }
  .mind-card p { font-size: clamp(0.95rem, 1.1vw, 1.15rem); line-height: 1.55; }
  .mind-card__future { color: var(--body); }

  /* ── Responsive ─────────────────────────────────────────────────────── */
  @media (max-width: 900px) {
    .mind-hero__grid { grid-template-columns: 1fr; grid-template-rows: auto auto auto; }
    .mind-hero__meta { grid-column: 1; grid-row: 1; }
    .mind-hero__marks { grid-column: 1; grid-row: 1; }
    .mind-hero__laptop { grid-column: 1; grid-row: 2; justify-self: center; margin-block: 1.5rem; }
    .mind-hero__title { grid-column: 1; grid-row: 3; }
    .mind-row, .mind-row--demo { grid-template-columns: 1fr; }
    .mind-row--cycle .mind-stack--lead { order: -1; }
    .mind-row--demo .mind-stack--lead { order: -1; }
    .mind-prio__row { gap: clamp(0.75rem, 3vw, 1.5rem); }
    .mind-cards { grid-template-columns: 1fr; }
  }
</style>

<script>
  // On touch/narrow screens, give the horizontally-scrollable journey map a
  // one-time nudge when it first enters view, hinting that it can be scrolled.
  const scroller = document.querySelector('.mind-jscroll');
  if (scroller instanceof HTMLElement && window.matchMedia('(max-width: 900px)').matches) {
    let played = false;
    const nudge = () => {
      const max = scroller.scrollWidth - scroller.clientWidth;
      if (max <= 8) return;
      const to = Math.min(max, 64);
      scroller.scrollTo({ left: to, behavior: 'smooth' });
      window.setTimeout(() => scroller.scrollTo({ left: 0, behavior: 'smooth' }), 650);
    };
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting && !played) {
          played = true;
          window.setTimeout(nudge, 400);
          io.disconnect();
        }
      }
    }, { threshold: 0.4 });
    io.observe(scroller);
  }
</script>
