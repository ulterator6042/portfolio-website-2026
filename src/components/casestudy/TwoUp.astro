---
/** Two-column block for side-by-side media or text. Stacks on mobile. */
---
<div class="cs-twoup">
  <div class="cs-twoup__col"><slot name="left" /></div>
  <div class="cs-twoup__col"><slot name="right" /></div>
</div>

<style>
  .cs-twoup {
    max-width: var(--page-max);
    margin: clamp(2rem, 5vw, 4rem) auto;
    padding-inline: var(--page-pad);
    display: grid;
    gap: clamp(1rem, 3vw, 2rem);
    grid-template-columns: 1fr 1fr;
  }
  @media (max-width: 720px) { .cs-twoup { grid-template-columns: 1fr; } }
  .cs-twoup__col :global(img) { width: 100%; border-radius: var(--radius-md); }
  .cs-twoup__col :global(p) { color: var(--muted); }
</style>
